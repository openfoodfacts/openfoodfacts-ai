    "ModelSettings": {
      "additionalProperties": false,
      "description": "Settings to configure an LLM.\n\nIncludes only settings which apply to multiple models / model providers,\nthough not all of these settings are supported by all models.\n\nAll types must be serializable using Pydantic.",
      "properties": {
        "max_tokens": {
          "title": "Max Tokens",
          "type": "integer"
        },
        "temperature": {
          "title": "Temperature",
          "type": "number"
        },
        "top_p": {
          "title": "Top P",
          "type": "number"
        },
        "top_k": {
