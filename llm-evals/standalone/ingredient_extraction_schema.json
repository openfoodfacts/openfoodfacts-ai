        "timeout": {
          "title": "Timeout",
          "type": "number"
        },
        "parallel_tool_calls": {
          "title": "Parallel Tool Calls",
          "type": "boolean"
        },
        "tool_choice": {
          "anyOf": [
            {
              "enum": ["none", "required", "auto"],
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "$ref": "#/$defs/ToolOrOutput"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tool Choice"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "presence_penalty": {
          "title": "Presence Penalty",
          "type": "number"
        },
        "frequency_penalty": {
          "title": "Frequency Penalty",
          "type": "number"
        },
        "logit_bias": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Logit Bias",
          "type": "object"
        },
        "stop_sequences": {
          "items": {
            "type": "string"
          },
          "title": "Stop Sequences",
          "type": "array"
        },
        "extra_headers": {
